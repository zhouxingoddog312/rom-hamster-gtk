<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <object class="GtkApplicationWindow" id="win">
    <property name="title">rom-hamster</property>
    <property name="default-width">1000</property>
    <property name="default-height">700</property>
    <child>
      <object class="GtkBox">
        <property name="orientation">vertical</property>
        <child>
          <object class="GtkHeaderBar">
            <property name="title-widget">
              <object class="GtkLabel">
                <property name="label">rom-hamster</property>
                <property name="single-line-mode">True</property>
              </object>
            </property>
            <child type="end">
              <object class="GtkButton" id="btn_rescan">
                <property name="label">Refresh</property>
                <property name="tooltip-text">Reload the library list</property>
              </object>
            </child>
            <child type="end">
              <object class="GtkButton" id="btn_import">
                <property name="label">Import</property>
                <property name="tooltip-text">Import a file or folder into the library</property>
              </object>
            </child>
            <child type="end">
              <object class="GtkButton" id="btn_cancel">
                <property name="label">Cancel</property>
                <property name="visible">False</property>
                <property name="tooltip-text">Cancel the running import</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkSearchEntry" id="search">
            <property name="placeholder-text">Search name, genre, publisher…</property>
            <property name="margin-start">12</property>
            <property name="margin-end">12</property>
            <property name="margin-top">8</property>
            <property name="margin-bottom">8</property>
          </object>
        </child>
        <child>
          <object class="GtkStack" id="stack">
            <property name="vexpand">True</property>
            <child>
              <object class="GtkScrolledWindow" id="list_scroll">
                <property name="hscrollbar-policy">automatic</property>
                <property name="vscrollbar-policy">automatic</property>
                <child>
                  <object class="GtkColumnView" id="list">
                    <property name="show-row-separators">True</property>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkBox" id="empty">
                <property name="orientation">vertical</property>
                <property name="valign">center</property>
                <property name="halign">center</property>
                <property name="spacing">12</property>
                <child>
                  <object class="GtkLabel">
                    <property name="label">No games in this library yet.</property>
                    <attributes>
                      <attribute name="scale" value="1.3"/>
                    </attributes>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel">
                    <property name="label">Use Import to add a folder to this library.</property>
                    <property name="wrap">True</property>
                    <property name="justify">center</property>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkProgressBar" id="progress">
            <property name="visible">False</property>
            <property name="margin-start">12</property>
            <property name="margin-end">12</property>
            <property name="margin-bottom">6</property>
          </object>
        </child>
        <child>
          <object class="GtkLabel" id="status">
            <property name="halign">start</property>
            <property name="margin-start">12</property>
            <property name="margin-end">12</property>
            <property name="margin-bottom">8</property>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
